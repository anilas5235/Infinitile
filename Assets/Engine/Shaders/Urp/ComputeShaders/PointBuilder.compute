#pragma kernel BuildPrep
#pragma kernel BuildPrepLight
#pragma kernel BuildPoints
#pragma kernel CopyIntervals

#include "VoxelComputeCommon.hlsl"
#include "../VoxelCommon.hlsl"

struct VoxelDef
{
    uint MeshLayer;
    uint AlwaysRenderAllFaces;
    uint DepthFadeDistance; // fp16 bits, read with f16tof32
    uint Glow;
    uint Collision;
    uint2 ShapeQuadIndicesAlwaysRender;
    uint2 ShapeQuadIndicesRight;
    uint2 ShapeQuadIndicesLeft;
    uint2 ShapeQuadIndicesUp;
    uint2 ShapeQuadIndicesDown;
    uint2 ShapeQuadIndicesFront;
    uint2 ShapeQuadIndicesBack;
    uint LightAttenuation; // 15 = opaque, skipped by the smooth light
};

struct VoxelQuad
{
    uint quadIndex;
    uint texIndex;
};

uint2 get_voxel_quad_indices(in VoxelDef def, uint dir)
{
    switch (dir)
    {
    case 0: return def.ShapeQuadIndicesRight;
    case 1: return def.ShapeQuadIndicesLeft;
    case 2: return def.ShapeQuadIndicesUp;
    case 3: return def.ShapeQuadIndicesDown;
    case 4: return def.ShapeQuadIndicesFront;
    case 5: return def.ShapeQuadIndicesBack;
    default: return 0;
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// BuildPrep Kernel - Expand compressed chunk data into flat arrays
// Each voxel's uint holds the voxel id (bits 0-15) and its light sky|R|G|B (bits 16-31). BuildPrep
// writes the ids, BuildPrepLight then ORs the light in, so a lookup fetches id and light at once.
// ─────────────────────────────────────────────────────────────────────────────

// _CompChunk is the shared interval store of every chunk (ChunkIntervalStore). A list is a sequence of
// pages of 512 elements anywhere in the store; _CompPages[_CompPagesOffset + p] is the store page of its page p.
// Element 0 of a list: (intervalCount, lastUncompressedIndex).
StructuredBuffer<uint2> _CompChunk;
StructuredBuffer<uint> _CompPages;
uint _CompPagesOffset;
RWStructuredBuffer<uint> _UnCompChunk;

uint2 CompInterval(uint k)
{
    uint page = _CompPages[_CompPagesOffset + (k >> COMP_PAGE_SHIFT)];
    return _CompChunk[(page << COMP_PAGE_SHIFT) | (k & COMP_PAGE_MASK)];
}

uint _VoxelsPerChunk;

[numthreads(PREP_THREADS, 1, 1)]
void BuildPrep(uint3 id : SV_DispatchThreadID)
{
    uint start_interval = 1 + id.x * PREP_INTERVALS_PER_THREAD; //+1 because interval 0 is metadata

    uint total_intervals = CompInterval(0).x;
    if (start_interval > total_intervals) return;

    for (int i = 0; i < PREP_INTERVALS_PER_THREAD; ++i)
    {
        uint target_interval = start_interval + i;
        if (target_interval > total_intervals) break;

        uint start_index = 0;
        if (target_interval > 1) start_index = CompInterval(target_interval - 1).y; // Previous page's end index

        uint2 page_data = CompInterval(target_interval);
        uint end_index = min(page_data.y, _VoxelsPerChunk);
        for (uint t_index = start_index; t_index < end_index; ++t_index)
        {
            _UnCompChunk[t_index] = page_data.x;
        }
    }
}

// Same interval walk as BuildPrep over the chunk's light list; the ids are already in place.
[numthreads(PREP_THREADS, 1, 1)]
void BuildPrepLight(uint3 id : SV_DispatchThreadID)
{
    uint start_interval = 1 + id.x * PREP_INTERVALS_PER_THREAD;

    uint total_intervals = CompInterval(0).x;
    if (start_interval > total_intervals) return;

    for (int i = 0; i < PREP_INTERVALS_PER_THREAD; ++i)
    {
        uint target_interval = start_interval + i;
        if (target_interval > total_intervals) break;

        uint start_index = 0;
        if (target_interval > 1) start_index = CompInterval(target_interval - 1).y;

        uint2 page_data = CompInterval(target_interval);
        uint light = (page_data.x & 0xFFFF) << 16;
        uint end_index = min(page_data.y, _VoxelsPerChunk);
        for (uint t_index = start_index; t_index < end_index; ++t_index)
        {
            _UnCompChunk[t_index] = (_UnCompChunk[t_index] & 0xFFFF) | light;
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Build Kernel - Generate solid point data per partition
// ─────────────────────────────────────────────────────────────────────────────

int3 _ChunkSize;
int3 _PartitionSize;
uint _PartitionIndex;

StructuredBuffer<VoxelDef> _VoxelRenderDefs;
uint _VoxelRenderDefsCount;
StructuredBuffer<uint> _VoxelQuadTexPairs;
uint _VoxelQuadTexPairsCount;

StructuredBuffer<uint> _MainChunk;
StructuredBuffer<uint> _NeighborChunk0; //(0,1)
StructuredBuffer<uint> _NeighborChunk1; //(1,1)
StructuredBuffer<uint> _NeighborChunk2; //(1,0)
StructuredBuffer<uint> _NeighborChunk3; //(1,-1)
StructuredBuffer<uint> _NeighborChunk4; //(0,-1)
StructuredBuffer<uint> _NeighborChunk5; //(-1,-1)
StructuredBuffer<uint> _NeighborChunk6; //(-1,0)
StructuredBuffer<uint> _NeighborChunk7; //(-1,1)

RWStructuredBuffer<PartitionMetadata> _Metadata;
// Counter buffers instead of append buffers, so a write past the capacity is skipped explicitly.
// The counter keeps counting; the CPU clamps the read-back count to _PointCapacity.
RWStructuredBuffer<PointData> _SolidPointsOut;
RWStructuredBuffer<PointData> _TransparentPointsOut;
RWStructuredBuffer<PointData> _FoliagePointsOut;
uint _PointCapacity;

// The prepared chunks hold id | light << 16; the lookups below return the whole cell, use
// cell_id / cell_light to split it.
uint cell_id(uint cell)
{
    return cell & 0xFFFF;
}

uint cell_light(uint cell)
{
    return cell >> 16;
}

#define SKY_ABOVE_WORLD (0xF000u << 16) // air with sky 15, the space above the world
#define NO_INNER_LIGHT 0xFFFFFFFFu

VoxelDef get_voxel_def(uint voxelId)
{
    voxelId = cell_id(voxelId);
    // One return; FXC flags the early-return form as potentially uninitialized.
    VoxelDef def = (VoxelDef)0;
    if (voxelId < _VoxelRenderDefsCount) def = _VoxelRenderDefs[voxelId];
    return def;
}

uint get_voxel_array_index(in int3 pos)
{
    return ((uint)pos.x << CHUNK_INDEX_SHIFT_X) + ((uint)pos.z << CHUNK_INDEX_SHIFT_Z) + (uint)pos.y;
}

uint get_voxel(StructuredBuffer<uint> target, in int3 in_chunk_pos)
{
    uint index = get_voxel_array_index(in_chunk_pos);
    if (index >= _VoxelsPerChunk) return 0; // Out of bounds, treat as air
    return target[index];
}

uint get_voxel_from_chunk_offset(in int2 chunk_offset, in int3 in_chunk_pos)
{
    if (abs(chunk_offset.x) > 1 || abs(chunk_offset.y) > 1) return 0;

    int ox = clamp(chunk_offset.x, -1, 1);
    int oy = clamp(chunk_offset.y, -1, 1);

    switch (ox)
    {
    case 1:
        switch (oy)
        {
        case 1: return get_voxel(_NeighborChunk1, in_chunk_pos);
        case 0: return get_voxel(_NeighborChunk2, in_chunk_pos);
        case -1: return get_voxel(_NeighborChunk3, in_chunk_pos);
        default: return get_voxel(_MainChunk, in_chunk_pos);
        }
    case 0:
        switch (oy)
        {
        case 1: return get_voxel(_NeighborChunk0, in_chunk_pos);
        case -1: return get_voxel(_NeighborChunk4, in_chunk_pos);
        default: return get_voxel(_MainChunk, in_chunk_pos);
        }
    case -1:
        switch (oy)
        {
        case 1: return get_voxel(_NeighborChunk7, in_chunk_pos);
        case 0: return get_voxel(_NeighborChunk6, in_chunk_pos);
        case -1: return get_voxel(_NeighborChunk5, in_chunk_pos);
        default: return get_voxel(_MainChunk, in_chunk_pos);
        }
    default:
        return get_voxel(_MainChunk, in_chunk_pos);
    }
}

// Helper: Get voxel from chunk-space position safely
uint get_voxel_safe(in int3 in_chunk_pos)
{
    int3 chunk_size = _ChunkSize;
    int3 part_size = _PartitionSize;
    if (in_chunk_pos.y < 0) return 0;
    if (in_chunk_pos.y >= chunk_size.y) return SKY_ABOVE_WORLD; // air in full sky light

    if (in_chunk_pos.x < 0 || in_chunk_pos.x >= part_size.x || in_chunk_pos.z < 0 || in_chunk_pos.z >=
        part_size.z)
    {
        if (in_chunk_pos.x < -part_size.x || in_chunk_pos.x >= 2 * part_size.x || in_chunk_pos.z < -part_size.z
            || in_chunk_pos.z >= 2 * part_size.z)
            return 0;

        int2 chunk_offset = int2(
            floor((float)in_chunk_pos.x / part_size.x),
            floor((float)in_chunk_pos.z / part_size.z)
        );

        int3 neighbor_chunk_pos = int3(
            in_chunk_pos.x - chunk_offset.x * part_size.x,
            in_chunk_pos.y,
            in_chunk_pos.z - chunk_offset.y * part_size.z
        );

        return get_voxel_from_chunk_offset(chunk_offset, neighbor_chunk_pos);
    }

    return get_voxel(_MainChunk, in_chunk_pos);
}

// Helper: Get direction offset
int3 get_direction_offset(uint dir)
{
    int3 offsets[6] = {
        int3(1, 0, 0), // Right
        int3(-1, 0, 0), // Left
        int3(0, 1, 0), // Up
        int3(0, -1, 0), // Down
        int3(0, 0, 1), // Forward
        int3(0, 0, -1) // Backward
    };
    return offsets[dir];
}

// Helper: Check if face should be rendered
bool should_render_face(in VoxelDef currentVoxel, in VoxelDef neighborVoxel)
{
    if (currentVoxel.AlwaysRenderAllFaces == (uint)true) return true;
    if (currentVoxel.MeshLayer < neighborVoxel.MeshLayer) return true;
    return false;
}

uint get_quad_tex_pair(uint index)
{
    if (index >= _VoxelQuadTexPairsCount) return 0; // Invalid
    return _VoxelQuadTexPairs[index];
}

bool is_solid(int3 in_chunk_pos)
{
    return get_voxel_def(get_voxel_safe(in_chunk_pos)).MeshLayer == MESH_LAYER_SOLID;
}

// ─────────────────────────────────────────────────────────────────────────────
// Smooth light
// ─────────────────────────────────────────────────────────────────────────────

#define OPAQUE_ATTENUATION 15

bool is_opaque(uint cell)
{
    return get_voxel_def(cell).LightAttenuation >= OPAQUE_ATTENUATION;
}

// Voxel light sky|R|G|B as one level per component.
uint4 unpack_light(uint light)
{
    return uint4(light >> 12 & 0xF, light >> 8 & 0xF, light >> 4 & 0xF, light & 0xF);
}

uint pack_light(uint4 levels)
{
    return (levels.x & 0xF) << 12 | (levels.y & 0xF) << 8 | (levels.z & 0xF) << 4 | (levels.w & 0xF);
}

// Light at one face corner: per channel the rounded average over the front voxel, the two side voxels and the
// diagonal voxel touching the corner, skipping opaque ones. The diagonal is also skipped when both sides are
// opaque (it is hidden behind them). With every voxel skipped the front voxel's light is used.
uint corner_light(int3 front, uint front_cell, int3 side_a, int3 side_b)
{
    uint cell_a = get_voxel_safe(front + side_a);
    uint cell_b = get_voxel_safe(front + side_b);
    uint cell_d = get_voxel_safe(front + side_a + side_b);
    bool open_a = !is_opaque(cell_a);
    bool open_b = !is_opaque(cell_b);
    bool open_d = (open_a || open_b) && !is_opaque(cell_d);

    uint4 sum = 0;
    uint n = 0;
    if (!is_opaque(front_cell)) { sum += unpack_light(cell_light(front_cell)); n++; }
    if (open_a) { sum += unpack_light(cell_light(cell_a)); n++; }
    if (open_b) { sum += unpack_light(cell_light(cell_b)); n++; }
    if (open_d) { sum += unpack_light(cell_light(cell_d)); n++; }

    if (n == 0) return cell_light(front_cell);
    return pack_light((sum + n / 2) / n);
}

// Corners ul, ur, dr, dl of a face (up = +V, right = +U, as for the AO bits).
uint4 face_corner_light(int3 front, int3 up, int3 right)
{
    uint front_cell = get_voxel_safe(front);
    return uint4(
        corner_light(front, front_cell, up, -right),
        corner_light(front, front_cell, up, right),
        corner_light(front, front_cell, -up, right),
        corner_light(front, front_cell, -up, -right));
}

// Light for quads inside the voxel (always-render shapes such as foliage): the voxel's own light, or for an opaque
// voxel the brightest of its six neighbours per channel.
uint inner_light(int3 in_chunk_pos, uint own_cell)
{
    if (!is_opaque(own_cell)) return cell_light(own_cell);
    uint4 brightest = 0;
    for (uint dir = 0; dir < 6; dir++)
    {
        uint cell = get_voxel_safe(in_chunk_pos + get_direction_offset(dir));
        if (!is_opaque(cell)) brightest = max(brightest, unpack_light(cell_light(cell)));
    }
    return pack_light(brightest);
}

// inner_light_value: light of quads inside the voxel, or NO_INNER_LIGHT for face quads (smooth light)
void add_quads(int3 in_chunk_pos, in float3 partitionPos, in VoxelDef myDef, uint2 quadRange, uint inner_light_value)
{
    for (uint i = 0u; i < quadRange.y; i++)
    {
        uint quad_tex_pair = get_quad_tex_pair(quadRange.x + i);
        // Generate point in world voxel space.
        PointData p;
        p.position = (float3)in_chunk_pos + float3(partitionPos.x, 0, partitionPos.z);

        uint4 packed = uint4(quad_tex_pair, 0, 0, 0);

        uint quadIndex = get_quad_index(packed);
        QuadData quad = _Quad_buffer[quadIndex];
        uint ao_mask = 0;
        int3 front_in_chunk = in_chunk_pos + quad.normal;

        if (inner_light_value == NO_INNER_LIGHT)
            set_corner_light(packed, face_corner_light(front_in_chunk, (int3)quad.up, (int3)quad.right));
        else
            set_corner_light(packed, inner_light_value);

        if (is_solid(front_in_chunk + quad.up)) ao_mask |= 1 << 0; // Up
        if (is_solid(front_in_chunk + quad.up + quad.right)) ao_mask |= 1 << 1; // UpRight
        if (is_solid(front_in_chunk + quad.right)) ao_mask |= 1 << 2; // Right
        if (is_solid(front_in_chunk + quad.right - quad.up)) ao_mask |= 1 << 3; // DownRight
        if (is_solid(front_in_chunk - quad.up)) ao_mask |= 1 << 4; // Down
        if (is_solid(front_in_chunk - quad.up - quad.right)) ao_mask |= 1 << 5; // DownLeft
        if (is_solid(front_in_chunk - quad.right)) ao_mask |= 1 << 6; // Left
        if (is_solid(front_in_chunk + quad.up - quad.right)) ao_mask |= 1 << 7; // UpLeft

        set_ao(packed, ao_mask);
        set_depth_fade_dist(packed, f16tof32(myDef.DepthFadeDistance));
        set_glow(packed, myDef.Glow);

        p.packed = packed;

        uint idx;
        switch (myDef.MeshLayer)
        {
        case 0: idx = _SolidPointsOut.IncrementCounter();
            if (idx < _PointCapacity) _SolidPointsOut[idx] = p;
            break;
        case 1: idx = _TransparentPointsOut.IncrementCounter();
            if (idx < _PointCapacity) _TransparentPointsOut[idx] = p;
            break;
        case 2: idx = _FoliagePointsOut.IncrementCounter();
            if (idx < _PointCapacity) _FoliagePointsOut[idx] = p;
            break;
        default: break;
        }
    }
}

[numthreads(BUILD_POINTS_THREADS, BUILD_POINTS_THREADS, BUILD_POINTS_THREADS)]
void BuildPoints(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_PartitionSize))) return;

    PartitionMetadata metadata = _Metadata[_PartitionIndex];
    int3 pos = (int3)id;
    float3 partitionWS = (float3)metadata.partitionWS;
    int3 in_chunk_pos = pos + int3(0, partitionWS.y, 0);
    uint cell = get_voxel(_MainChunk, in_chunk_pos);
    uint voxelId = cell_id(cell);

    if (voxelId == 0) return; // Skip air

    VoxelDef myDef = get_voxel_def(voxelId);

    if (myDef.ShapeQuadIndicesAlwaysRender.y > 0)
        add_quads(in_chunk_pos, partitionWS, myDef, myDef.ShapeQuadIndicesAlwaysRender, inner_light(in_chunk_pos, cell));

    // Check 6 neighbors for face exposure
    for (uint dir = 0; dir < 6; dir++)
    {
        int3 neighbor_chunk_pos = in_chunk_pos + get_direction_offset(dir);
        uint neighborId = get_voxel_safe(neighbor_chunk_pos);
        VoxelDef otherDef = get_voxel_def(neighborId);

        if (!should_render_face(myDef, otherDef)) continue;

        uint2 quadData = get_voxel_quad_indices(myDef, dir);
        add_quads(in_chunk_pos, partitionWS, myDef, quadData, NO_INNER_LIGHT);
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// CopyIntervals Kernel - copies the interval store into its larger replacement (ChunkIntervalStore.Grow)
// ─────────────────────────────────────────────────────────────────────────────

StructuredBuffer<uint2> _CopySource;
RWStructuredBuffer<uint2> _CopyTarget;
uint _CopyCount;
uint _CopyStride; // threads in the dispatch; each thread copies every _CopyStride-th element

[numthreads(COPY_INTERVALS_THREADS, 1, 1)]
void CopyIntervals(uint3 id : SV_DispatchThreadID)
{
    for (uint i = id.x; i < _CopyCount; i += _CopyStride)
        _CopyTarget[i] = _CopySource[i];
}
