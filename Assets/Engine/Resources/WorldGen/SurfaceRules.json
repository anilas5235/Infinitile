{
  "formatVersion": 1,
  "climate": {
    "lapse": 0.0055,
    "lapseFrom": 124,
    "snowTemperature": -0.638,
    "snowWobble": "snow_wobble",
    "iceTemperature": -0.6,
    "iceWobble": "ice_wobble",
    "treeLineBelowSnow": 15,
    "treeLineFloor": 170,
    "treeLineWobble": "tree_line_wobble",
    "nearWaterDistance": 16,
    "beachShape": "beach_shape"
  },
  "strata": {
    "period": 7,
    "thickness": 2,
    "shift": "strata_shift"
  },
  "blocks": {
    "snow": "std:Snow",
    "snow_layer": "std:SnowLayer",
    "dark_rock": "std:StoneGrey",
    "grassy_rock": "std:StoneGrassy",
    "litter": "std:Litter",
    "coarse_dirt": "std:DirtCoarse",
    "sandy_dirt": "std:DirtSandy",
    "mud": "std:Mud",
    "moss": "std:Moss",
    "leaf_litter": "std:LitterLeaves",
    "needle_litter": "std:Litter",
    "peat": "std:Peat",
    "clay": "std:Clay",
    "gravel": "std:StoneGravel",
    "cobble": "std:Cobblestone",
    "granite": "std:Granite",
    "diorite": "std:Diorite",
    "andesite": "std:Andesite",
    "marble": "std:Marble"
  },
  "globalBefore": [
    {
      "name": "snow",
      "if": { "all": ["floor", "dry", "sky_open", { "temperature": "snow" }, { "not": "never_snows" }] },
      "then": {
        "sequence": [
          {
            "name": "snow_cliff",
            "if": "steep",
            "then": {
              "sequence": [
                { "name": "snow_cliff_dark", "if": { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }, "then": { "block": "@dark_rock" } },
                { "name": "snow_cliff_rock", "then": { "block": "@rock" } }
              ]
            }
          },
          {
            "name": "snow_ledge",
            "if": { "steep": 2 },
            "then": {
              "sequence": [
                { "name": "snow_ledge_dark", "if": { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }, "then": { "block": "@dark_rock", "cover": "@snow_layer" } },
                { "name": "snow_ledge_rock", "then": { "block": "@rock", "cover": "@snow_layer" } }
              ]
            }
          },
          {
            "name": "snow_peak",
            "if": { "not": "below_tree_line" },
            "then": { "block": "@snow" }
          },
          {
            "name": "snow_step",
            "if": { "steep": 1 },
            "then": { "block": "@snow" }
          },
          {
            "name": "snow_ground",
            "then": { "block": "@under", "cover": "@snow_layer" }
          }
        ]
      }
    },
    {
      "name": "snow_rock_under",
      "if": { "all": [{ "stone_depth_above": 4 }, { "not": "floor" }, "dry", { "steep": 2 }, { "temperature": "snow" }, { "not": "never_snows" }] },
      "then": {
        "sequence": [
          { "name": "snow_rock_under_dark", "if": { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }, "then": { "block": "@dark_rock" } },
          { "name": "snow_rock_under_rock", "then": { "block": "@rock" } }
        ]
      }
    }
  ],
  "default": [
    {
      "name": "surface",
      "if": { "above_preliminary_surface": "delta_down" },
      "then": {
        "sequence": [
          {
            "name": "river_bed",
            "if": { "all": ["floor", { "water_depth": [1, 255] }, { "river": 0.3 }] },
            "then": {
              "sequence": [
                { "name": "river_bed_mud", "if": { "biome": "Swamp" }, "then": { "block": "@mud" } },
                { "name": "river_bed_sand", "if": { "noise_threshold": { "name": "ground_mix", "min": 0.35 } }, "then": { "block": "@beach" } },
                { "name": "river_bed_clay", "if": { "noise_threshold": { "name": "ground_mix", "max": -0.35 } }, "then": { "block": "@clay" } },
                { "name": "river_bed_gravel", "then": { "block": "@gravel" } }
              ]
            }
          },
          {
            "name": "shallow_floor",
            "if": { "all": ["floor", { "water_depth": [1, 3] }] },
            "then": { "block": "@beach" }
          },
          {
            "name": "underwater_mix",
            "if": { "all": ["floor", { "water_depth": [4, 255] }, { "not": { "biome": ["Desert", "Badlands"] } }] },
            "then": {
              "sequence": [
                { "name": "underwater_peat", "if": { "all": [{ "biome": "Swamp" }, { "noise_threshold": { "name": "ground_mix", "min": 0.3 } }] }, "then": { "block": "@peat" } },
                { "name": "underwater_gravel", "if": { "all": [{ "not": { "biome": "Swamp" } }, { "noise_threshold": { "name": "ground_mix", "min": 0.35 } }] }, "then": { "block": "@gravel" } },
                { "name": "underwater_clay", "if": { "noise_threshold": { "name": "ground_mix", "max": -0.35 } }, "then": { "block": "@clay" } }
              ]
            }
          },
          {
            "name": "underwater_top",
            "if": { "all": ["floor", { "water_depth": [1, 255] }] },
            "then": { "block": "@underwater_top" }
          },
          {
            "name": "shore_cliff",
            "if": { "all": [{ "stone_depth_above": 4 }, "dry", "near_water", { "top_above_water": [0, 4] }, { "steep": 3 }] },
            "then": { "block": "@rock" }
          },
          {
            "name": "shore_sand",
            "if": { "all": [{ "stone_depth_above": 2 }, "dry", "near_water", { "top_above_water": [0, 2] }, { "not": { "steep": 3 } }] },
            "then": { "block": "@beach" }
          },
          {
            "name": "beach",
            "if": { "all": [{ "stone_depth_above": 2 }, "dry", "beach_band", "near_water"] },
            "then": { "block": "@beach" }
          },
          {
            "name": "steep",
            "if": { "all": [{ "stone_depth_above": 4 }, { "not": "floor" }, "dry", "steep"] },
            "then": {
              "sequence": [
                { "name": "steep_marble", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_kind", "max": -0.5 } }, { "noise_threshold": { "name": "ground_mix", "min": 0.3 } }] }, "then": { "block": "@marble" } },
                { "name": "steep_diorite", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_kind", "max": -0.5 } }] }, "then": { "block": "@diorite" } },
                { "name": "steep_granite", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_kind", "min": 0.5 } }] }, "then": { "block": "@granite" } },
                { "name": "steep_andesite", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }, { "noise_threshold": { "name": "ground_mix", "min": 0.4 } }] }, "then": { "block": "@andesite" } },
                { "name": "steep_dark", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }] }, "then": { "block": "@dark_rock" } },
                { "name": "steep_rock", "then": { "block": "@rock" } }
              ]
            }
          },
          {
            "name": "alpine",
            "if": { "all": [{ "stone_depth_above": 4 }, "dry", { "not": "below_tree_line" }] },
            "then": {
              "sequence": [
                { "name": "alpine_marble", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_kind", "max": -0.5 } }, { "noise_threshold": { "name": "ground_mix", "min": 0.3 } }] }, "then": { "block": "@marble" } },
                { "name": "alpine_diorite", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_kind", "max": -0.5 } }] }, "then": { "block": "@diorite" } },
                { "name": "alpine_granite", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_kind", "min": 0.5 } }] }, "then": { "block": "@granite" } },
                { "name": "alpine_andesite", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }, { "noise_threshold": { "name": "ground_mix", "min": 0.4 } }] }, "then": { "block": "@andesite" } },
                { "name": "alpine_dark", "if": { "all": [{ "not": { "biome": ["Desert", "Badlands"] } }, { "noise_threshold": { "name": "rock_mix", "min": -0.3 } }] }, "then": { "block": "@dark_rock" } },
                { "name": "alpine_rock", "then": { "block": "@rock" } }
              ]
            }
          },
          {
            "name": "ground",
            "if": { "all": ["floor", "dry", "below_tree_line"] },
            "then": {
              "sequence": [
                { "name": "ground_steep_cap", "if": { "all": ["steep", { "biome": ["Forest", "Jungle", "Plains", "Savanna", "Swamp", "Taiga"] }, { "noise_threshold": { "name": "ground_mix", "min": -0.1 } }] }, "then": { "block": "@grassy_rock" } },
                { "name": "ground_shore", "if": { "all": ["near_water", { "top_above_water": [2, 6] }, { "biome": ["Forest", "Jungle", "Plains", "Savanna", "Taiga"] }, { "noise_threshold": { "name": "ground_mix", "min": -0.2 } }] }, "then": { "block": "@sandy_dirt" } },
                { "name": "ground_scree", "if": { "all": [{ "biome": "Mountain" }, { "steep": 2 }, { "noise_threshold": { "name": "ground_mix", "min": 0.35 } }] }, "then": { "block": "@cobble" } },
                { "name": "ground_moss", "if": { "all": [{ "biome": ["Forest", "Jungle", "Swamp", "Taiga"] }, { "noise_threshold": { "name": "rock_mix", "max": -0.55 } }] }, "then": { "block": "@moss" } },
                { "name": "ground_leaves", "if": { "all": [{ "biome": ["Forest", "Jungle"] }, { "noise_threshold": { "name": "ground_mix", "min": 0.3 } }] }, "then": { "block": "@leaf_litter" } },
                { "name": "ground_needles", "if": { "all": [{ "biome": "Taiga" }, { "noise_threshold": { "name": "ground_mix", "min": 0.45 } }] }, "then": { "block": "@needle_litter" } },
                { "name": "ground_coarse", "if": { "all": [{ "biome": "Savanna" }, { "noise_threshold": { "name": "ground_mix", "min": 0.25 } }] }, "then": { "block": "@coarse_dirt" } },
                { "name": "ground_coarse_taiga", "if": { "all": [{ "biome": "Taiga" }, { "noise_threshold": { "name": "ground_mix", "max": -0.4 } }] }, "then": { "block": "@coarse_dirt" } },
                { "name": "ground_bare", "if": { "all": [{ "biome": "Plains" }, { "noise_threshold": { "name": "ground_mix", "min": 0.5 } }] }, "then": { "block": "@coarse_dirt" } },
                { "name": "ground_mud", "if": { "all": [{ "biome": "Swamp" }, { "noise_threshold": { "name": "ground_mix", "min": 0.4 } }] }, "then": { "block": "@mud" } },
                { "name": "ground_peat", "if": { "all": [{ "biome": "Swamp" }, { "noise_threshold": { "name": "ground_mix", "max": -0.45 } }] }, "then": { "block": "@peat" } },
                { "name": "ground_dry", "if": { "all": [{ "biome": "Savanna" }, { "noise_threshold": { "name": "ground_mix", "max": -0.55 } }] }, "then": { "block": "@sandy_dirt" } }
              ]
            }
          },
          {
            "name": "forest_floor",
            "if": { "all": ["floor", "dry", "dense_forest"] },
            "then": { "block": "@forest_floor" }
          },
          {
            "name": "meadow",
            "if": { "all": ["floor", "dry", "below_tree_line"] },
            "then": { "block": "@meadow" }
          },
          {
            "name": "top",
            "if": "floor",
            "then": { "block": "@top" }
          },
          {
            "name": "under",
            "if": { "stone_depth_above": 4 },
            "then": { "block": "@under" }
          }
        ]
      }
    },
    {
      "name": "stone",
      "then": { "block": "@stone" }
    }
  ],
  "biomes": {},
  "globalAfter": []
}
