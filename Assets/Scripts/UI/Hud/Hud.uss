.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(235, 235, 235);
    font-size: 14px;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    -unity-background-scale-mode: scale-to-fit;
}

.message {
    position: absolute;
    top: 12px;
    left: 30%;
    right: 30%;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 6px 12px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.6);
    font-size: 15px;
}

.column {
    position: absolute;
    top: 12px;
    width: 360px;
}

.column--left {
    left: 12px;
}

.column--right {
    right: 12px;
}

.panel {
    margin-bottom: 8px;
    padding: 6px 10px 8px 10px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.55);
}

.panel__title {
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(255, 214, 120);
    margin-bottom: 2px;
    padding: 0;
}

.row {
    padding: 0;
    margin: 1px 0;
    white-space: normal;
}

.row--strong {
    -unity-font-style: bold;
}

.row--dim {
    color: rgb(190, 190, 190);
    font-size: 12px;
    margin-top: 4px;
}

.button-row,
.bookmarks {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.bookmark {
    flex-direction: row;
    margin-right: 6px;
    margin-bottom: 2px;
}

.hud-button {
    margin: 0 4px 0 0;
    padding: 2px 8px;
    min-width: 28px;
    font-size: 12px;
    color: rgb(235, 235, 235);
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
}

.hud-button:hover {
    background-color: rgba(255, 255, 255, 0.28);
}

.hud-button:active {
    background-color: rgba(255, 214, 120, 0.45);
}

.hud-button.hud-button--empty {
    color: rgb(190, 190, 190);
    background-color: rgba(0, 0, 0, 0);
}

.hint {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.45);
}

.hotbar-area {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    align-items: center;
}

.voxel-name {
    margin-bottom: 4px;
    padding: 2px 10px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    font-size: 15px;
}

.hotbar {
    flex-direction: row;
    padding: 4px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
}

.slot {
    width: 52px;
    height: 52px;
    margin: 2px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
}

.slot--selected {
    border-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.25);
}

.slot__icon {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.slot__key {
    position: absolute;
    left: 2px;
    top: 0;
    padding: 0;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.85);
}
