#pragma kernel CopyPoints

#include "VoxelComputeCommon.hlsl"
#include "../VoxelCommon.hlsl"

// ─────────────────────────────────────────────────────────────────────────────
// Copy Points Kernel - Copy points to final buffer for rendering
// ─────────────────────────────────────────────────────────────────────────────
StructuredBuffer<PointData> _SolidPointsIn;
RWStructuredBuffer<PointData> _SolidPointsCopyOut;
StructuredBuffer<uint2> _SolidPages; //Index & Count

StructuredBuffer<PointData> _TransparentPointsIn;
RWStructuredBuffer<PointData> _TransparentPointsCopyOut;
StructuredBuffer<uint2> _TransparentPages;

StructuredBuffer<PointData> _FoliagePointsIn;
RWStructuredBuffer<PointData> _FoliagePointsCopyOut;
StructuredBuffer<uint2> _FoliagePages;

StructuredBuffer<uint> _PageCounts;

[numthreads(COPY_POINTS_THREADS, 1, 1)] // one group per page and mesh layer, one thread per point of the page
void CopyPoints(uint3 group : SV_GroupID, uint inPage : SV_GroupIndex)
{
    uint page = group.x;
    uint layer = group.y; // the dispatch has one row of groups per mesh layer
    if (page >= _PageCounts[layer]) return; // No more pages to process in this layer

    // The layer is the same for the whole group, so these branches never diverge
    uint2 indexAndCount;
    switch (layer)
    {
    case 0: indexAndCount = _SolidPages[page];
        break;
    case 1: indexAndCount = _TransparentPages[page];
        break;
    case 2: indexAndCount = _FoliagePages[page];
        break;
    default:
        return;
    }

    if (inPage >= min(indexAndCount.y, POINTS_PER_PAGE)) return;

    uint src = page * POINTS_PER_PAGE + inPage;
    uint dst = indexAndCount.x * POINTS_PER_PAGE + inPage;

    switch (layer)
    {
    case 0: // Solid
        _SolidPointsCopyOut[dst] = _SolidPointsIn[src];
        break;
    case 1: // Transparent
        _TransparentPointsCopyOut[dst] = _TransparentPointsIn[src];
        break;
    case 2: // Foliage
        _FoliagePointsCopyOut[dst] = _FoliagePointsIn[src];
        break;
    default: break;
    }
}
